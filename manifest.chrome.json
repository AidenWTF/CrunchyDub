{
  "manifest_version": 3,
  "name": "CrunchyDub",
  "version": "1.6.0",
  "description": "Shows which dub (audio) languages each series has on Crunchyroll and lets you filter by them. Not affiliated with Crunchyroll.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["https://www.crunchyroll.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
