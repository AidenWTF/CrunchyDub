{
  "manifest_version": 2,
  "name": "CrunchyDub",
  "version": "1.5.0",
  "description": "Shows which dub (audio) languages each series has on Crunchyroll and lets you filter by them. Not affiliated with Crunchyroll.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://www.crunchyroll.com/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crunchydub@addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
